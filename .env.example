# LLM API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Default LLM Provider (gemini | openai | groq | ollama)
DEFAULT_PROVIDER=gemini
DEFAULT_MODEL=gemini-2.5-flash

# Local Ollama (optional — for offline/DeepSeek-R1 usage)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:latest

# LangSmith Tracing & Observability
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT="peoplequery-ai"

# Database Configuration
DATABASE_URL="sqlite:///./data/hr_database.sqlite"
DB_QUERY_TIMEOUT_SECONDS=15
DB_MAX_ROWS_RETURNED=100

# RAG & Chroma Configuration
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
DOCS_DIR="./company_docs"
CHROMA_PERSIST_DIR="./data/chroma_db"
TOP_K_RETRIEVAL=4
BM25_TOP_K=4

# Evaluation Loop Bounds
MAX_EVALUATION_RETRIES=2
