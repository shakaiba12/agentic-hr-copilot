# ==============================================================================
# PeopleQuery AI - Environment Configuration Template (.env.example)
# Copy this file to .env and configure your environment variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Project & Environment Metadata
# ------------------------------------------------------------------------------
PROJECT_NAME="PeopleQuery AI"
APP_ENV=development
DEBUG=false

# ------------------------------------------------------------------------------
# 2. LLM Provider API Keys
# Provide at least one API key corresponding to your chosen DEFAULT_PROVIDER
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
HF_TOKEN=your_huggingface_token_here

# ------------------------------------------------------------------------------
# 3. Default LLM Provider & Model Selection
# Supported providers: gemini | openai | groq | ollama
# ------------------------------------------------------------------------------
DEFAULT_PROVIDER=groq
DEFAULT_MODEL=openai/gpt-oss-120b
DEFAULT_TEMPERATURE=0.0

# Provider-specific Model Defaults
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=openai/gpt-oss-120b

# Local Ollama Settings (When DEFAULT_PROVIDER=ollama or for local DeepSeek/Qwen)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b

# ------------------------------------------------------------------------------
# 4. LangSmith Observability & Tracing (Optional)
# ------------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT="people-query-hr"

# ------------------------------------------------------------------------------
# 5. Database & Query Configuration
# ------------------------------------------------------------------------------
DATABASE_URL="sqlite:///./data/hr_database.sqlite"
DB_QUERY_TIMEOUT_SECONDS=15
DB_MAX_ROWS_RETURNED=100
MAX_CONVERSATION_HISTORY=10

# ------------------------------------------------------------------------------
# 6. RAG (Retrieval-Augmented Generation) & ChromaDB Configuration
# ------------------------------------------------------------------------------
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
DOCS_DIR="./company_docs"
CHROMA_PERSIST_DIR="./data/chroma_db"
TOP_K_RETRIEVAL=4
BM25_TOP_K=4

# ------------------------------------------------------------------------------
# 7. LLM-as-a-Judge & Evaluation Bounds
# ------------------------------------------------------------------------------
ENABLE_LLM_JUDGE=true
JUDGE_PROVIDER=groq
JUDGE_MODEL=openai/gpt-oss-120b
JUDGE_TEMPERATURE=0.0
MAX_JUDGE_RETRIES=1
JUDGE_TIMEOUT_SECONDS=10
JUDGE_SCORE_THRESHOLD=0.7

MAX_EVALUATION_RETRIES=2
MAX_SQL_RETRIES=2

# ------------------------------------------------------------------------------
# 8. Guardrails & Safety Policies
# ------------------------------------------------------------------------------
MAX_INPUT_LENGTH=2000
REQUIRE_CITATIONS_FOR_RAG=true
MASK_INDIVIDUAL_SALARIES=true
